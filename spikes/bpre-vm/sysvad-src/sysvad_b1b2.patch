+// B1 (RFC Track B): pull-driven advance. One call = one notification period consumed + notified,
+// driven externally by the user-mode pseudo-K11 (later the real K11 playback callback).
+VOID CMiniportWaveRTStream::PullAdvance()
+{
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_PositionSpinLock, &oldIrql);
+    if (m_KsState == KSSTATE_RUN && m_ulDmaMovementRate > 0 && m_ulNotificationIntervalMs > 0)
+    {
+        ULONG bytes = (m_ulDmaMovementRate * m_ulNotificationIntervalMs) / 1000;
+        LARGE_INTEGER qpc = KeQueryPerformanceCounter(NULL);
+
+        m_ullPresentationPosition += bytes;
+        if (m_bCapture) { WriteBytes(bytes); }
+        else if (!g_DoNotCreateDataFiles) { ReadBytes(bytes); }
+        m_ullPlayPosition = m_ullWritePosition = (m_ullWritePosition + bytes) % m_ulDmaBufferSize;
+        m_ullLinearPosition += bytes;
+        m_ullDmaTimeStamp = KSCONVERT_PERFORMANCE_TIME(m_ullPerformanceCounterFrequency.QuadPart, qpc);
+        m_llPacketCounter++;
+
+        if (!IsListEmpty(&m_NotificationList))
+        {
+            PLIST_ENTRY le = m_NotificationList.Flink;
+            while (le != &m_NotificationList)
+            {
+                NotificationListEntry* nle = CONTAINING_RECORD(le, NotificationListEntry, ListEntry);
+                KeSetEvent(nle->NotificationEvent, 0, FALSE);
+                le = le->Flink;
+            }
+        }
+    }
+    KeReleaseSpinLock(&m_PositionSpinLock, oldIrql);
+}
+
+VOID CMiniportWaveRTStream::PullThreadRoutine(_In_ PVOID StartContext)
+{
+    CMiniportWaveRTStream* _this = (CMiniportWaveRTStream*)StartContext;
+    PVOID objs[2];
+    objs[0] = _this->m_pPullEvent;          // user-mode pseudo-K11 tick
+    objs[1] = &_this->m_PullStopEvent;      // shutdown
+    LARGE_INTEGER timeout;
+    timeout.QuadPart = (-100) * ((LONGLONG)HNSTIME_PER_MILLISECOND);  // 100 ms free-run watchdog
+    for (;;)
+    {
+        NTSTATUS st = KeWaitForMultipleObjects(2, objs, WaitAny, Executive, KernelMode, FALSE,
+                                               &timeout, NULL);
+        if (st == STATUS_WAIT_0 + 1) { break; }     // stop requested
+        _this->PullAdvance();                       // tick (WAIT_0) or timeout free-run
+    }
+    PsTerminateSystemThread(STATUS_SUCCESS);
+}
+//=============================================================================
 
 

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "World-Locked Binaural Surround",
  "version": "0.1.0",
  "identifier": "com.jeanibarz.worldlocked",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "World-Locked Binaural Surround",
        "width": 1320,
        "height": 864,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
